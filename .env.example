DATA_DIR=data
POSTGRES_PASSWORD=
ADMIN_TOKEN=
REVIEWER_TOKEN=
RATE_LIMIT_SALT=
FORWARDED_ALLOW_IPS=127.0.0.1
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_JSON_MODE=1
# DeepSeek handles generation and claim verification. Keep retrieval services
# separate from the DeepSeek API. OpenAI embeddings example (API usage is billed
# separately from ChatGPT subscriptions):
# EMBEDDER_BASE_URL=https://api.openai.com/v1
# EMBEDDER_API_KEY=<OpenAI-API-key>
# EMB_MODEL=text-embedding-3-small
# Alternative: Cloudflare Workers AI BGE-M3:
# EMBEDDER_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1
# EMBEDDER_API_KEY=<Workers-AI-scoped-token>
# EMB_MODEL=@cf/baai/bge-m3
# Store the token only in the server-side .env file; never commit it.
EMBEDDER_BASE_URL=
EMBEDDER_API_KEY=
RERANKER_BASE_URL=
RERANKER_API_KEY=
EMB_MODEL=@cf/baai/bge-m3
RERANKER_MODEL=qwen/qwen3-reranker-8b
VERIFIER_MODEL=
